{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/index.ts", "src/components/**/index.ts"],
  "exclude": [
    "node_modules/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.stories.tsx",
    "src/**/demos/**",
    "src/**/__tests__/**",
    "src/app.tsx",
    "src/main.tsx",
    "src/components/doc-template/**",
    "src/components/docs/**"
  ]
}
